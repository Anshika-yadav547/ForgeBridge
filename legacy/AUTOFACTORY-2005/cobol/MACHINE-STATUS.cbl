       IDENTIFICATION DIVISION.
       PROGRAM-ID. MACHINE-STATUS.

       DATA DIVISION.
       WORKING-STORAGE SECTION.

       01 MACHINE-ID              PIC 99 VALUE 7.
       01 TEMPERATURE-C           PIC 99V9 VALUE 86.2.
       01 TEMPERATURE-LIMIT-C     PIC 99V9 VALUE 85.0.
       01 COOLANT-FLOW-LPM       PIC 99 VALUE 22.
       01 VIBRATION-MM-S         PIC 99V9 VALUE 3.1.
       01 EMERGENCY-STOP         PIC X VALUE "N".
       01 ALARM-ACTIVE           PIC X VALUE "N".
       01 PRODUCTION-ENABLED     PIC X VALUE "Y".
       01 STOP-REASON            PIC X(40) VALUE "NORMAL".

       PROCEDURE DIVISION.
       MAIN-LOGIC.

           PERFORM CHECK-EMERGENCY-STOP
           PERFORM CHECK-TEMPERATURE
           PERFORM CHECK-COOLANT
           PERFORM CHECK-VIBRATION
           PERFORM DISPLAY-STATUS

           STOP RUN.

       CHECK-EMERGENCY-STOP.

           IF EMERGENCY-STOP = "Y"
               MOVE "Y" TO ALARM-ACTIVE
               MOVE "N" TO PRODUCTION-ENABLED
               MOVE "EMERGENCY STOP ENGAGED" TO STOP-REASON
           END-IF.

       CHECK-TEMPERATURE.

           IF TEMPERATURE-C >= TEMPERATURE-LIMIT-C
               MOVE "Y" TO ALARM-ACTIVE
               MOVE "N" TO PRODUCTION-ENABLED
               MOVE "TEMPERATURE LIMIT EXCEEDED" TO STOP-REASON
           END-IF.

       CHECK-COOLANT.

           IF COOLANT-FLOW-LPM < 10
               MOVE "Y" TO ALARM-ACTIVE
               MOVE "N" TO PRODUCTION-ENABLED
               MOVE "INSUFFICIENT COOLANT FLOW" TO STOP-REASON
           END-IF.

       CHECK-VIBRATION.

           IF VIBRATION-MM-S > 7.5
               MOVE "Y" TO ALARM-ACTIVE
               MOVE "N" TO PRODUCTION-ENABLED
               MOVE "EXCESSIVE VIBRATION" TO STOP-REASON
           END-IF.

       DISPLAY-STATUS.

           DISPLAY "COBOL MACHINE STATUS"
           DISPLAY "MACHINE: " MACHINE-ID
           DISPLAY "ALARM: " ALARM-ACTIVE
           DISPLAY "PRODUCTION ENABLED: " PRODUCTION-ENABLED
           DISPLAY "REASON: " STOP-REASON.